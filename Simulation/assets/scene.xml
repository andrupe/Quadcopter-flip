<mujoco model="quadcopter_scene">
  <include file="quadcopter.xml"/>

  <option timestep="0.005" gravity="0 0 -9.81" integrator="Euler" density="1.225" viscosity="1.8e-5"/>

  <visual>
    <headlight ambient="0.35 0.35 0.35" diffuse="0.75 0.75 0.75" specular="0.2 0.2 0.2"/>
    <rgba haze="0.08 0.12 0.18 1"/>
    <quality shadowsize="4096"/>
    <map shadowclip="1.0" znear="0.01"/>
    <global azimuth="140" elevation="-20" offwidth="1920" offheight="1080"/>
  </visual>

  <asset>
    <!-- Sleek deep gradient skybox -->
    <texture type="skybox" builtin="gradient" rgb1="0.10 0.15 0.25" rgb2="0.02 0.03 0.06" width="512" height="512"/>

    <!-- High-visibility checkered ground grid -->
    <texture name="grid" type="2d" builtin="checker" width="512" height="512"
             rgb1="0.15 0.18 0.24" rgb2="0.22 0.26 0.34"/>
    <material name="grid_mat" texture="grid" texrepeat="10 10" texuniform="true" reflectance="0.12" roughness="0.6"/>

    <!-- Translucent target footprint material -->
    <material name="target_ring_mat" rgba="0.2 0.85 0.4 0.35"/>
  </asset>

  <worldbody>
    <!-- Default Framing Cameras (Positioned close to drone for optimal visibility) -->
    <camera name="isometric" mode="fixed" pos="0.75 -0.75 1.4" xyaxes="0.707 0.707 0 -0.38 0.38 0.84"/>
    <camera name="side_view" mode="fixed" pos="0 -1.0 1.0" xyaxes="1 0 0 0 0 1"/>
    <camera name="tracking" mode="trackcom" pos="0.7 -0.7 0.35" xyaxes="0.707 0.707 0 -0.38 0.38 0.84"/>

    <!-- High-Visibility Physical Ground Plane (Floor) -->
    <geom name="floor" type="plane" size="10 10 0.05" material="grid_mat" friction="1.0 0.005 0.0001" contype="1" conaffinity="1"/>

    <!-- Primary Directional Sun Light with Shadows -->
    <light directional="true" pos="2 -2 6" dir="-0.3 0.3 -1.0" diffuse="0.9 0.9 0.9" specular="0.3 0.3 0.3" castshadow="true"/>
    <!-- Fill light for soft illumination -->
    <light directional="false" pos="-2 2 4" diffuse="0.35 0.35 0.4" specular="0 0 0"/>

    <!-- Target Waypoint Visual Indicator at active waypoint position -->
    <body name="target_marker" pos="0 0 1.2" mocap="true">
      <geom name="target_core" type="sphere" size="0.035" rgba="0.2 0.95 0.4 0.7" contype="0" conaffinity="0"/>
      <geom name="target_aura" type="sphere" size="0.065" rgba="0.2 0.95 0.4 0.25" contype="0" conaffinity="0"/>
    </body>
  </worldbody>
</mujoco>
